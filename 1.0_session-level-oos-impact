WITH pdp_events AS (
  SELECT
    parse_date('%Y%m%d', event_date) AS event_date,
    CONCAT(user_pseudo_id, '_', (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id')) AS session_id,
    event_timestamp,
    event_name,
    event_value_in_usd,
    
    -- Item details
    item.item_id,
    item.item_name,
    item.item_brand,
    item.item_variant,
    item.item_category,
    
    -- Stock status parameter
    COALESCE(
      (SELECT value.string_value FROM UNNEST(item.item_params) WHERE key = 'stockstatus'), 
      'unknown'
    ) AS stock_status

  FROM
    `your-project.analytics_123456789.events_*`
  LEFT JOIN
    UNNEST(items) AS item
  WHERE
    _TABLE_SUFFIX BETWEEN '20261018' AND '20261025'
),

session_behavior AS (
  SELECT
    event_date,
    session_id,
    
    -- Session interaction flags
    MAX(IF(event_name = 'view_item', 1, 0)) AS visited_pdp,
    MAX(IF(event_name = 'view_item' AND stock_status != 'instock', 1, 0)) AS visited_oos_pdp,
    MAX(IF(event_name = 'view_item' AND stock_status = 'instock', 1, 0)) AS visited_instock_pdp,
    
    -- First PDP item attributes viewed in the session (Entry/Landing Item)
    ARRAY_AGG(
      IF(event_name = 'view_item', item_id, NULL) 
      IGNORE NULLS ORDER BY event_timestamp ASC LIMIT 1
    )[SAFE_OFFSET(0)] AS item_id,

    ARRAY_AGG(
      IF(event_name = 'view_item', item_name, NULL) 
      IGNORE NULLS ORDER BY event_timestamp ASC LIMIT 1
    )[SAFE_OFFSET(0)] AS item_name,

    ARRAY_AGG(
      IF(event_name = 'view_item', item_brand, NULL) 
      IGNORE NULLS ORDER BY event_timestamp ASC LIMIT 1
    )[SAFE_OFFSET(0)] AS item_brand,

    ARRAY_AGG(
      IF(event_name = 'view_item', item_variant, NULL) 
      IGNORE NULLS ORDER BY event_timestamp ASC LIMIT 1
    )[SAFE_OFFSET(0)] AS item_variant,

    ARRAY_AGG(
      IF(event_name = 'view_item', item_category, NULL) 
      IGNORE NULLS ORDER BY event_timestamp ASC LIMIT 1
    )[SAFE_OFFSET(0)] AS item_category,

    -- Conversion metrics
    MAX(IF(event_name = 'purchase', 1, 0)) AS made_purchase,
    SUM(IF(event_name = 'purchase', COALESCE(event_value_in_usd, 0), 0)) AS session_revenue,
    COUNT(IF(event_name = 'purchase', 1, NULL)) AS session_purchases

  FROM
    pdp_events
  GROUP BY
    event_date,
    session_id
)

SELECT
  event_date,
  
  -- Aligned Item Dimensions (matching Option B structure)
  COALESCE(item_id, 'No PDP Viewed') AS item_id,
  COALESCE(item_name, 'No PDP Viewed') AS item_name,
  COALESCE(item_brand, 'No PDP Viewed') AS item_brand,
  COALESCE(item_variant, 'No PDP Viewed') AS item_variant,
  COALESCE(item_category, 'No PDP Viewed') AS item_category,
  
  -- Session Classification
  CASE 
    WHEN visited_pdp = 0 THEN 'Non-PDP Session'
    WHEN visited_oos_pdp = 1 AND made_purchase = 1 THEN 'OOS Recovered (Purchased)'
    WHEN visited_oos_pdp = 1 AND made_purchase = 0 THEN 'OOS Abandoned (No Purchase)'
    ELSE 'Pure In-Stock PDP Session'
  END AS session_type,

  -- Aggregated Metrics
  COUNT(DISTINCT session_id) AS total_sessions,
  SUM(visited_pdp) AS pdp_sessions,
  SUM(visited_oos_pdp) AS oos_pdp_sessions,
  SUM(visited_instock_pdp) AS instock_pdp_sessions,
  SUM(made_purchase) AS purchasing_sessions,
  SUM(session_purchases) AS total_purchases,
  SUM(session_revenue) AS total_revenue

FROM
  session_behavior
GROUP BY
  event_date,
  item_id,
  item_name,
  item_brand,
  item_variant,
  item_category,
  session_type;
